# Copy to .env and adjust. All values are optional for local development.
PORT=3000
# MONGO_URI=mongodb://127.0.0.1:27017
# MONGO_URI=mongodb+srv://user:pass@cluster0.example.mongodb.net
MONGO_DB=chat_system
# Set a long random value outside development.
JWT_SECRET=change-me-to-a-long-random-string
MESSAGE_RETENTION_DAYS=30
# NODE_ENV=production   # hides the OTP from API responses
